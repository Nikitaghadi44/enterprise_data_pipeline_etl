# Copy this file to .env and fill in real values. Never commit .env.

# ---- Database --------------------------------------------------------
# "sqlite" needs zero setup (default) -- good for local dev/demo.
# "mysql" is what docker-compose and production use.
DB_ENGINE=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=analytics_platform
DB_USER=root
DB_PASSWORD=@ni665

# ---- ETL ---------------------------------------------------------------
USE_API_SOURCE=false
API_SOURCE_URL=https://jsonplaceholder.typicode.com/todos

# ---- Monitoring / Alerts ------------------------------------------------
ERROR_RATE_THRESHOLD_PCT=5.0
RESPONSE_TIME_THRESHOLD_MS=800
CPU_HIGH_THRESHOLD=85.0
CPU_MEDIUM_THRESHOLD=50.0
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false

# ---- Scheduler ------------------------------------------------------------
ETL_INTERVAL_MINUTES=5
REPORT_INTERVAL_HOURS=24

# ---- Flask ------------------------------------------------------------------
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=change-this-to-something-random
